# Copy to home/.env and fill in. Git ignores home/.env.
# Home Assistant's MQTT broker. Leave ANOVA_MQTT_URL empty to turn MQTT off.
ANOVA_MQTT_URL=mqtt://<ha-host>:1883
ANOVA_MQTT_USERNAME=
ANOVA_MQTT_PASSWORD=
# Do not run this server on the App's broker while the App runs. Another
# client ID is not enough: both use the same topics, entities and retained
# "offline" message. Use another ANOVA_MQTT_CLIENT_ID,
# ANOVA_MQTT_TOPIC_PREFIX and ANOVA_MQTT_DISCOVERY_PREFIX, or leave
# ANOVA_MQTT_URL empty.
ANOVA_MQTT_CLIENT_ID=anova-oven-mac
