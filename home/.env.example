# Copy to home/.env and fill in. Git ignores home/.env.
# Home Assistant's MQTT broker. Leave ANOVA_MQTT_URL empty to turn MQTT off.
ANOVA_MQTT_URL=mqtt://<ha-host>:1883
ANOVA_MQTT_USERNAME=
ANOVA_MQTT_PASSWORD=
# The App uses anova-oven-server. With another ID, this test server and the
# App can share the broker.
ANOVA_MQTT_CLIENT_ID=anova-oven-mac
